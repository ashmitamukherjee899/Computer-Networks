using namespace std;

class Chat
{
    public:
    void sendMessage(SOCKET sockfd, char message[100])
    {
        send(sockfd, message, strlen(message), 0); //0=default sending behavior
    }
    void receiveMessage(SOCKET sockfd, char message[100])
    {
        int n = recv(sockfd, message, 99, 0);

        if(n>0)
        {
            message[n]='\0';
        }
    }
};

